FROM 15.0-RELEASE

PARAM allow.sysvipc=true

RUN pkg install -y postgresql18-server

SERVICE postgresql --no-user
LOG /var/log/postgresql.log

# Initialize the database cluster
RUN su -m postgres -c 'initdb -D /var/db/postgres/data18'

# Copy configs to listen on all interfaces
COPY --chown=postgres:postgres postgresql.conf /var/db/postgres/data18/postgresql.conf
COPY --chown=postgres:postgres pg_hba.conf /var/db/postgres/data18/pg_hba.conf
